# City defaults (Shanghai demo values)
DEFAULT_CITY=上海
DEFAULT_CITY_LAT=31.2304
DEFAULT_CITY_LNG=121.4737
MAX_PARALLEL_ROUTES=4

# Database (leave empty to use local SQLite at data/citycity.db)
DATABASE_URL=

# Map provider: built-in implementation uses Amap Web Service API.
# Keep secrets server-side; never expose AMAP_API_KEY through VITE_* variables.
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_API_KEY=replace_with_your_amap_web_service_key
AMAP_PROXY_TOKEN=

# LLM
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional image polishing (Volcengine Jimeng)
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=

# Optional authentication (Logto)
LOGTO_ENDPOINT=
LOGTO_APP_ID=
VITE_LOGTO_ENDPOINT=
VITE_LOGTO_APP_ID=

# Optional analytics (Umami; VITE_* values are public browser configuration)
VITE_UMAMI_SCRIPT_SRC=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_DOMAINS=

# Optional payment (Alipay)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
ALIPAY_NOTIFY_URL=http://localhost:8001/api/webhooks/alipay

# App
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
EXTRA_IMAGE_HOSTS=
SUBSCRIPTION_PRICE_CENTS=990
FREE_POLISH_LIMIT=1
